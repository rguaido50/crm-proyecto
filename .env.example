# Postgres credentials for the db service in docker-compose.yml. Local dev
# works fine with these defaults; set a real POSTGRES_PASSWORD for a deployment.
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# The app's own connection string (crm/core/config.py), read by both alembic
# and uvicorn. Pick exactly ONE of the two lines below and uncomment it —
# there's no safe shared default, since the correct host depends on whether
# the app is running on the host or inside the app container, and the app
# can't tell which. Leaving both commented falls back to the localhost
# default below, which is correct for local dev and fails loudly (connection
# refused) if used for a deployment by mistake.

# Local development (`uv run uvicorn` / `uv run pytest`, on the host):
# DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm

# Deployed via `docker compose up` (see docker-compose.yml): the app runs
# inside the Compose network and reaches Postgres by the db service's name,
# not localhost — must match the credentials above.
# DATABASE_URL=postgresql+psycopg://crm:crm@db:5432/crm

# Only used by `uv run pytest` on the host against the db-test service
# (`docker compose up -d db db-test`) — not needed for a deployment.
DATABASE_URL_TEST=postgresql+psycopg://crm:crm@localhost:55432/crm_test
