# Postgres credentials for the db service in docker-compose.yml. Local dev
# works fine with these defaults; set a real POSTGRES_PASSWORD for a
# deployment — any character is fine, docker/entrypoint.sh composes and
# percent-encodes the app's own DATABASE_URL from these automatically, so
# there's nothing else to configure for a deploy.
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# Local development / running tests on the host (uv run ...): Postgres is
# reached via docker-compose's host port mapping, so DATABASE_URL points at
# localhost. Not read by the containerized app — see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
DATABASE_URL_TEST=postgresql+psycopg://crm:crm@localhost:55432/crm_test
